# --- Database ---
# Local dev (Postgres via `npm run db:up`):
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Base URL of the app (used by Auth.js for callbacks in production).
AUTH_URL="http://localhost:3000"

# --- Seeded admin account ---
# Created/updated by `npm run db:seed`. Change these for a real deployment.
ADMIN_EMAIL="suganthjayanthi@gmail.com"
ADMIN_PASSWORD="abcd1234"

# --- Container host binding (docker-compose.prod.yml) ---
# Where the app container publishes its port on the host. Defaults to
# 0.0.0.0:3000. Behind a reverse proxy, bind localhost and pick a free port,
# e.g. APP_HOST=127.0.0.1 and APP_PORT=3002.
APP_HOST="0.0.0.0"
APP_PORT="3000"
