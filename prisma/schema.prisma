generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The single admin account (credentials seeded from env).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // bcrypt hash
  name      String?
  createdAt DateTime @default(now())
}

/// Configurable content categories (e.g. "posts", "projects").
model Category {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  order       Int            @default(0)
  // Optional listing-page copy — headline + blurb shown above the list.
  // Both fall back gracefully when blank (see app/[category]/page.tsx).
  tagline     String?
  description String?
  // How this category's posts are displayed, both on its own listing page
  // and in its section on the home page: "card" (grid) or "list" (spotlight
  // rows). Admin-configured per category — there is no visitor-facing toggle.
  listStyle   String         @default("card")
  createdAt   DateTime       @default(now())
  posts       PostCategory[]

  @@index([order])
}

/// A portfolio item. Content is stored as HTML (Tiptap output); the listing
/// hover image is derived from the first <img> inside `contentHtml` — there is
/// no separate cover-image field by design.
model Post {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  contentHtml String         @default("")
  excerpt     String?
  published   Boolean        @default(false)
  // Editable date shown to visitors everywhere the post's date appears. Lets a
  // post written today reflect when its content is really from. Null falls back
  // to `createdAt` for display. Never affects ordering — see `order`.
  displayDate DateTime?
  // Manual sort position for all listings (ascending). Admin-controlled via
  // drag-and-drop in admin → Posts; replaces createdAt as the listing order.
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  categories  PostCategory[]

  @@index([published, createdAt])
  @@index([order])
}

/// Many-to-many join: a post can belong to multiple categories.
model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

/// Single-row site configuration (id is always "singleton").
model SiteConfig {
  id          String   @id @default("singleton")
  title       String   @default("My Portfolio")
  description String   @default("A configurable portfolio.")
  // Substring of `description` to render as an accent-colored italic
  // highlight in the hero headline (e.g. "don't wake you up"). Blank renders
  // the headline plain; a value that isn't found in `description` is ignored.
  headlineHighlight String?
  // Profile picture shown in the hero avatar circle — a URL or a data: URI
  // (the admin uploader downsizes the image client-side and stores it as
  // one). Blank falls back to the owner's initial letter.
  avatarUrl   String?
  // Personal / contact details — all optional, all editable in admin settings.
  ownerName    String?
  email        String?
  location     String?
  bio          String? // longer hero paragraph under the tagline
  availability String? // e.g. "Available for work"; shows the hero badge when set
  // About page — all optional, all blank by default (no fabricated content).
  aboutHtml    String? // rich-text body for the About page
  currentRole  String? // e.g. "Senior engineer, platform team"
  tools        String? // comma-separated, e.g. "Go, TypeScript, Postgres"
  updatedAt    DateTime @updatedAt
}

/// Configurable personal/social links (GitHub, LinkedIn, X, website, …).
/// Fully CRUD-able in admin so any "other stuff" can be added or removed.
model SocialLink {
  id       String   @id @default(cuid())
  label    String // e.g. "GitHub", "LinkedIn", "Resume"
  url      String
  platform String   @default("link") // icon hint: github|linkedin|twitter|instagram|youtube|website|email|link
  order    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

/// A message submitted through the public contact form. Persisted so nothing is
/// lost if delivery (email via Resend) fails; `delivered` records whether the
/// notification was accepted. Reviewable in admin → Messages.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
